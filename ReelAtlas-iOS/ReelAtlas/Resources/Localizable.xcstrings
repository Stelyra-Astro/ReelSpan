    "home.location_not_indexed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This place is not yet present in the local movie-location index. The Apple Maps result is shown, but no movie query can be made until the dataset contains a matching city, region, or country."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该地点尚未收录在本地电影地点索引中。Apple 地图仍会显示该地点，但在本地数据包含对应城市、地区或国家之前，无法查询电影。"
          }
        }
      }
    },
    "home.map_parent_match": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not indexed directly. Using %@ for local movie matching."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 尚未直接收录，已使用 %@ 进行本地电影匹配。"
          }
        }
      }
    },
