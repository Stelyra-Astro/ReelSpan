    "settings.tmdb_key_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored securely in this device's Keychain. Movie details, cast, posters, and backdrops are fetched only when a movie is displayed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Key 会安全存储在本机钥匙串中；只有电影实际显示时才会按需拉取详情、演员、海报和背景图。"
          }
        }
      }
    },
