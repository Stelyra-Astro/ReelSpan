      }
    },
    "legal.about.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "legal.help.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this area in the production app for FAQ, data-correction reports and support contact information. A useful data report should include the movie title, selected place/year and the incorrect story time or narrative location."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正式版本可在这里提供常见问题、数据纠错和支持联系方式。有效的数据纠错报告应包含电影名称、所选地点/年份以及错误的故事时间或地点。"
          }
        }
      }
    },
    "legal.help.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help & Feedback"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帮助与反馈"
          }
        }
      }
    },
    "legal.licenses.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current MVP uses Apple system frameworks including SwiftUI, MapKit, StoreKit, Foundation and SQLite supplied by the platform SDK. No third-party Swift package is required by this project skeleton."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 MVP 使用平台 SDK 提供的 Apple 系统框架，包括 SwiftUI、MapKit、StoreKit、Foundation 和 SQLite。本项目骨架不依赖第三方 Swift Package。"
          }
        }
      }
    },
    "legal.licenses.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Source Licenses"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开源许可"
          }
        }
      }
    },
    "legal.privacy.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ReelSpan does not require a user account. Favorites, interface preferences, and other local app settings are stored on the user's device.\n\nMovie metadata and images are retrieved through ReelSpan-operated infrastructure using Cloudflare, Supabase, and The Movie Database (TMDB).\n\nIf location permission is granted, ReelSpan may use the user's current location to center the map. ReelSpan does not intentionally store precise location history.\n\nOptional tips are processed by Apple through StoreKit. ReelSpan does not receive or store payment card information.\n\nReelSpan does not use advertising SDKs or cross-app tracking."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ReelSpan 不要求用户注册账号。收藏、界面偏好和其他本地应用设置保存在用户设备上。\n\n电影元数据和图片通过 ReelSpan 运营的基础设施获取，使用 Cloudflare、Supabase 和 The Movie Database（TMDB）。\n\n如果授予位置权限，ReelSpan 可能使用用户当前位置将地图居中。ReelSpan 不会有意保存精确位置历史。\n\n可选打赏由 Apple 通过 StoreKit 处理。ReelSpan 不接收或存储银行卡信息。\n\nReelSpan 不使用广告 SDK，也不进行跨应用跟踪。"
          }
        }
      }
    },
    "legal.privacy.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy Policy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐私政策"
          }
        }
      }
    },
    "legal.sources.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TMDB — movie metadata and images\n\nWikidata / open knowledge sources — story location, story period and identifiers\n\nCurated data — normalization and correction of story time/location data"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TMDB — 电影元数据和图片\n\nWikidata / 开放知识来源 — 故事地点、故事时期和标识符\n\n整理数据 — 故事时间/地点数据的归一化与修正"
          }
        }
      }
    },
    "legal.sources.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data Sources"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据来源"
          }
        }
      }
    },
    "legal.terms.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ReelSpan is free to use. Optional tips are consumable in-app purchases processed by Apple. Tips are voluntary and do not unlock features, provide digital content, create a subscription, grant credits, or provide any permanent entitlement.\n\nMovie metadata and images may be provided by third-party services including The Movie Database (TMDB). Story locations and story periods may be derived from open knowledge sources and curated data. Movie and story data may contain errors, omissions, or differing interpretations.\n\nConsumable tips do not create restorable entitlements and do not require a user account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ReelSpan 免费使用。可选打赏是由 Apple 处理的消耗型 App 内购买项目。打赏是自愿的，不会解锁功能、提供数字内容、创建订阅、授予 credits 或任何永久权益。\n\n电影元数据和图片可能由包括 The Movie Database（TMDB）在内的第三方服务提供。故事地点和故事时期可能来自开放知识来源与整理数据。电影和故事数据可能存在错误、遗漏或不同解释。\n\n消耗型打赏不产生可恢复的权益，也不需要用户账号。"
          }
        }
      }
    },
    "legal.terms.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terms of Use"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用条款"
          }
        }
      }
    },
    "legal.tmdb.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ReelSpan uses The Movie Database (TMDB) for movie metadata and images.\n\nThis product uses the TMDB API but is not endorsed or certified by TMDB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ReelSpan 使用 The Movie Database（TMDB）提供电影元数据和图片。\n\n本产品使用 TMDB API，但未得到 TMDB 的背书或认证。"
          }
        }
      }
    },
