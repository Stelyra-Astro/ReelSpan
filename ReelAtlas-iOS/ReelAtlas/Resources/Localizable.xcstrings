    "favorites.empty.message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe bei einem Film auf das Herz, um ihn hier zu speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the heart on a movie to save it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el corazón de una película para guardarla aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le cœur d’un film pour l’enregistrer ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il cuore su un film per salvarlo qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映画のハートをタップすると、ここに保存できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영화의 하트를 탭하면 여기에 저장됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no coração de um filme para guardá-lo aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击电影上的心形按钮即可收藏到这里。"
          }
        }
      }
    },
